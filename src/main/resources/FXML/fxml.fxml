<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="es.marco.Controlador.Controlador">
    <top>
        <VBox spacing="10" alignment="TOP_CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <!-- Fila para Nombre con botón añadir a la derecha -->
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="%label.nombre"/>
                <TextField fx:id="campoNombre" promptText="%prompt.nombre"/>
                <Button text="%button.añadir" onAction="#agregarPersona"/>
            </HBox>

            <!-- Fila para Apellido -->
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="%label.apellido"/>
                <TextField fx:id="campoApellido" promptText="%prompt.apellido"/>
            </HBox>

            <!-- Fila para Fecha Nac -->
            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="%label.fecha"/>
                <DatePicker fx:id="campoFecha"/>
            </HBox>

            <!-- Fila con botones Restaurar y Eliminar alineados a la izquierda -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="%button.restaurar" onAction="#restaurarFilas"/>
                <Button text="%button.eliminar" onAction="#eliminarFilasSeleccionadas"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tablaPersonas" prefHeight="200">
            <columns>
                <TableColumn fx:id="colID" text="%table.id" prefWidth="50"/>
                <TableColumn fx:id="colNombre" text="%table.nombre" prefWidth="100"/>
                <TableColumn fx:id="colApellido" text="%table.apellido" prefWidth="100"/>
                <TableColumn fx:id="colFecha" text="%table.fechaNacimiento" prefWidth="120"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
